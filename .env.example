NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SECRET_KEY=your_secret_key
# Automatic listing fetch stays off until explicitly enabled. Do not set this for user search.
# AUTO_REFRESH_LIVE=0
# AUTO_REFRESH_ENABLE_FETCH=0
# AUTO_REFRESH_PYTHON=
# AUTO_REFRESH_FETCH_SCRIPT=
# AUTO_REFRESH_TIMEOUT_MS=15000
# AUTO_REFRESH_DRY_RUN=1
# AUTO_REFRESH_PERSIST=0
# AUTO_REFRESH_ALLOW_STUB=0
NEXT_PUBLIC_DONATION_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: set this to the live HTTPS origin, e.g. https://nextbosman-app.vercel.app
# Used for canonical URLs, Open Graph, Twitter cards, and sitemap.xml.
# OAuth callback origin is taken from the current request host, not this value.
# Enable Google in Supabase: Auth → Providers → Google
# Auth → URL Configuration:
#   Site URL = https://nextbosman-app.vercel.app
#   Redirect URLs:
#     http://localhost:3000/auth/callback**
#     https://nextbosman-app.vercel.app/auth/callback**
