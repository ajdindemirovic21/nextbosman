# Copy to the repo root as .env.prod-refresh.local (gitignored).
# Public and service-role keys are loaded from this file only.
# .env.local is opened read-only so its NEXT_PUBLIC_SUPABASE_URL host can pin
# AUTO_REFRESH_PROD_HOST independently. Keys from .env.local are never applied.
# Allowed source use is not yet settled. The SDK MIT license is not Transfermarkt data rights.
#
# AUTO_REFRESH_PROD_HOST must be the exact Supabase host of production (no https://).
AUTO_REFRESH_PROD_HOST=YOUR_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTO_REFRESH_PYTHON=
# Do not set AUTO_REFRESH_LIVE, AUTO_REFRESH_ENABLE_FETCH, or AUTO_REFRESH_PERSIST in this file.
# Enable those only in the PowerShell session for one manual batch.
